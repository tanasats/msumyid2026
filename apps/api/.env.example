PORT=4010
TRUST_PROXY=                              # production หลัง nginx = 1 (ห้าม true)
WEB_URL=http://localhost:3010
CORS_ORIGIN=http://localhost:3010
DATABASE_URL=postgres://app:app@localhost:5442/app_dev
TEST_DATABASE_URL=postgres://app:app@localhost:5442/app_test
LOG_LEVEL=info                            # fatal | error | warn | info | debug | trace | silent
SESSION_COOKIE_NAME=msumyid_session          # ชื่อเฉพาะโปรเจกต์ (cookie บน localhost ใช้ร่วมกันทุก port)

# Google OAuth — สร้าง OAuth Client (Web application) ที่ Google Cloud Console
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=                     # ค่าจริงอยู่ใน apps/api/.env เท่านั้น ห้าม commit
GOOGLE_REDIRECT_URI=http://localhost:4010/auth/google/callback   # ต้องตรงกับที่ลงทะเบียนกับ Google ทุกตัวอักษร
# ALLOWED_EMAIL_DOMAINS, SESSION_TTL_DAYS, CRL_VALIDITY_DAYS, CRL_REISSUE_HOURS ย้ายไปหน้า /admin/settings (ตาราง system_settings) แล้ว
INITIAL_SUPER_ADMIN_EMAIL=tanasat.s@msu.ac.th   # ใช้เฉพาะ pnpm --filter api seed:super-admin (ต้อง login ด้วย Google 1 ครั้งก่อน)

# ERP-HR มมส. — ดึงข้อมูลบุคลากรด้วย Google access token ตอน login (docs/erp_hr_msu_staff_info_integration.md)
ERP_HR_STAFFINFO_URL=https://erp.msu.ac.th/service/api/staffinfo
ERP_HR_TIMEOUT_MS=5000                    # เกินเวลานี้ข้ามไป (login ยังผ่าน ใช้ข้อมูลเดิมที่เคยเก็บไว้)

# รอบตรวจปิดบัญชีที่ถึงวันหมดอายุ (ms, ไม่ใส่ = 1 ชั่วโมง) — การตัดสิทธิ์มีผลทันทีอยู่แล้ว
ACCOUNT_EXPIRY_CHECK_INTERVAL_MS=3600000

# บริการเซ็น (apps/signer) — ออกใบรับรองและถือ key สำรอง
SIGNER_URL=http://localhost:4020
SIGNER_TOKEN=                             # ค่าเดียวกับ SIGNER_TOKEN ของ apps/signer/.env
SIGNER_TIMEOUT_MS=30000                   # สร้าง RSA 4096 อาจใช้เวลาหลายวินาที
# ประทับเวลาลายมือชื่อบน PDF (RFC 3161) — MSU TSA
TSA_URL=https://tsa.msu.ac.th/tsa
TSA_TIMEOUT_MS=15000

# CRL — ออกใหม่ทันทีเมื่อมีการเพิกถอน และตามรอบที่ตั้งในหน้า /admin/settings เผยแพร่ที่ GET /crl/msu-ca.crl (cdp.msu.ac.th ดึงไป)
CRL_CHECK_INTERVAL_MS=300000              # รอบตรวจ/ลองใหม่เมื่อ signer ล่ม
CRL_PUBLISH_FORMAT=pem                    # pem = แบบเดียวกับ openssl ca -gencrl เดิม, der = ตาม RFC 5280
