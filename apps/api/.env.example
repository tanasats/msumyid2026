PORT=4010
TRUST_PROXY=                              # production หลัง nginx = 1 (ห้าม true)
WEB_URL=http://localhost:3010
CORS_ORIGIN=http://localhost:3010
DATABASE_URL=postgres://app:app@localhost:5442/app_dev
TEST_DATABASE_URL=postgres://app:app@localhost:5442/app_test
LOG_LEVEL=info                            # fatal | error | warn | info | debug | trace | silent
SESSION_COOKIE_NAME=msumyid_session          # ชื่อเฉพาะโปรเจกต์ (cookie บน localhost ใช้ร่วมกันทุก port)
SESSION_TTL_DAYS=7

# Google OAuth — สร้าง OAuth Client (Web application) ที่ Google Cloud Console
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=                     # ค่าจริงอยู่ใน apps/api/.env เท่านั้น ห้าม commit
GOOGLE_REDIRECT_URI=http://localhost:4010/auth/google/callback   # ต้องตรงกับที่ลงทะเบียนกับ Google ทุกตัวอักษร
ALLOWED_EMAIL_DOMAINS=msu.ac.th           # โดเมนที่ไม่ต้องรออนุมัติ (คั่นด้วย ,) โดเมนอื่น = บุคลากรภายนอก รออนุมัติ
INITIAL_SUPER_ADMIN_EMAIL=tanasat.s@msu.ac.th   # ใช้เฉพาะ pnpm --filter api seed:super-admin (ต้อง login ด้วย Google 1 ครั้งก่อน)
