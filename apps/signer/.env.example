# บริการเซ็น (apps/signer) — ถือ key ของ Intermediate CA และ KEK ของ key สำรอง เปิดเฉพาะเครือข่ายภายใน ให้ API เรียกเท่านั้น
SIGNER_PORT=4020
LOG_LEVEL=info                            # fatal | error | warn | info | debug | trace | silent
SIGNER_TOKEN=                             # ค่าเดียวกับ SIGNER_TOKEN ของ apps/api/.env (อย่างน้อย 32 ตัว: openssl rand -hex 32)
OPENSSL_BIN=openssl                       # path ของ OpenSSL CLI ถ้าไม่อยู่ใน PATH

# Intermediate CA — dev ใช้ CA ปลอมจาก pnpm --filter signer dev-ca (ห้ามนำ CA key จริงมาไว้บนเครื่อง dev)
CA_CERT_PATH=
CA_KEY_PATH=
CA_KEY_PASSPHRASE=

# KEK ของ key สำรอง: base64 ของ 32 ไบต์ (openssl rand -base64 32) — หายแล้วกู้ key สำรองทั้งหมดไม่ได้ ต้องสำรองไว้ออฟไลน์
ESCROW_KEK=
ESCROW_KEK_ID=dev-1

CRL_DISTRIBUTION_URL=https://cdp.msu.ac.th/msu-ca.crl   # ฝังในใบรับรองทุกใบ (ใบเดิมใช้ URL นี้)
CERT_VALIDITY_DAYS=365
USER_KEY_BITS=4096
