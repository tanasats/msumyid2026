PORT=3010                                  # port ของ web (อ่านตอน pnpm dev / start)
API_URL=http://localhost:4010              # ใช้ฝั่ง server (Server Component)
NEXT_PUBLIC_API_URL=http://localhost:4010  # ใช้ฝั่ง browser
SESSION_COOKIE_NAME=msumyid_session        # ต้องตรงกับ apps/api/.env (proxy ใช้ตรวจว่ามี cookie หรือไม่ เพื่อ UX เท่านั้น)
