# คัดลอกเป็น /opt/msumyid/.env (chmod 600) — ค่าของ docker compose และสคริปต์ (ไม่มี secret)
# รูปแบบ KEY=value ล้วน: docker ไม่ตัดคอมเมนต์ท้ายบรรทัดหรือเครื่องหมายคำพูด ให้เขียนคอมเมนต์ไว้บรรทัดของมันเอง

# แท็กของ image ที่ทำงานอยู่ (deploy.sh / rollback.sh แก้ให้เอง)
APP_TAG=sha-0000000
# image บน GHCR: <prefix>-api, <prefix>-web, <prefix>-signer
IMAGE_PREFIX=ghcr.io/tanasats/msumyid2026

# uid/gid ของผู้ใช้ deploy (id -u / id -g) — container อ่านไฟล์ secret สิทธิ์ 600 ของผู้ใช้นี้ได้
APP_UID=1001
APP_GID=1001

# port บน host (bind 127.0.0.1 เท่านั้น ให้ nginx เรียก) — เปลี่ยนได้ถ้าชนกับระบบอื่น ต้องแก้ใน nginx ด้วย
WEB_PORT=3000
API_PORT=4000

# backup: เก็บกี่วัน และปลายทางนอก VM (rsync over ssh) — ว่าง = เก็บบน VM เท่านั้น (สคริปต์เตือน)
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE=
