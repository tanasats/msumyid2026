# คัดลอกเป็น env/signer.env (chmod 600) — ค่าที่ไม่ลับของบริการเซ็น
# ค่าลับ (SIGNER_TOKEN, CA_KEY_PASSPHRASE, ESCROW_KEK) อยู่ในโฟลเดอร์ secrets/ ไม่ใช่ที่นี่ — ดู scripts/init-secrets.sh
# path ของใบรับรอง/key กำหนดใน compose.yml แล้ว
NODE_ENV=production
LOG_LEVEL=info
OPENSSL_BIN=openssl
# ชื่อ KEK ตัวปัจจุบัน (เก็บคู่กับ key สำรองทุกก้อน) เปลี่ยนเมื่อหมุน KEK
ESCROW_KEK_ID=prod-1
# ฝังในใบรับรองทุกใบ — ใบเดิมใช้ค่านี้ เปลี่ยนไม่ได้
CRL_DISTRIBUTION_URL=https://cdp.msu.ac.th/msu-ca.crl
# เพดานอายุใบ (วัน) — อายุจริงตามนโยบายที่ super_admin ตั้งในระบบ (หน้า /admin/certificate-policy)
CERT_VALIDITY_DAYS=825
USER_KEY_BITS=4096
