# คัดลอกเป็น env/api.env (chmod 600) — ค่าของ API production
# รูปแบบ KEY=value ล้วน (ห้ามคอมเมนต์ท้ายบรรทัด ห้ามใส่เครื่องหมายคำพูด)
# PORT, SIGNER_URL, SIGNER_TOKEN_FILE กำหนดใน compose.yml แล้ว

NODE_ENV=production
# หลัง nginx 1 ชั้น (Cloudflare → nginx ใช้ realip แล้ว) — ห้าม true
TRUST_PROXY=1
LOG_LEVEL=info
WEB_URL=https://did.msu.ac.th
CORS_ORIGIN=https://did.msu.ac.th
# รหัสผ่านเดียวกับ POSTGRES_PASSWORD ใน env/postgres.env (host = ชื่อ service postgres)
DATABASE_URL=postgres://msumyid:CHANGE_ME@postgres:5432/msumyid

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
# ต้องตรงกับที่ลงทะเบียนใน Google Cloud Console ทุกตัวอักษร
GOOGLE_REDIRECT_URI=https://did.msu.ac.th/api/auth/google/callback
SESSION_COOKIE_NAME=msumyid_session
# ALLOWED_EMAIL_DOMAINS, SESSION_TTL_DAYS, CRL_VALIDITY_DAYS, CRL_REISSUE_HOURS ย้ายไปหน้า /admin/settings (ตาราง system_settings) แล้ว
# ใช้เฉพาะ seed super_admin ครั้งแรก
INITIAL_SUPER_ADMIN_EMAIL=tanasat.s@msu.ac.th

ERP_HR_STAFFINFO_URL=https://erp.msu.ac.th/service/api/staffinfo
ERP_HR_TIMEOUT_MS=5000
ACCOUNT_EXPIRY_CHECK_INTERVAL_MS=3600000

SIGNER_TIMEOUT_MS=30000
# ประทับเวลาลายมือชื่อบน PDF (RFC 3161) — MSU TSA
TSA_URL=https://tsa.msu.ac.th/tsa
TSA_TIMEOUT_MS=15000
CRL_CHECK_INTERVAL_MS=300000
CRL_PUBLISH_FORMAT=pem

# ระบบอีเมลยังไม่ได้สร้าง
MAIL_TRANSPORT=log
