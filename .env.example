# ค่าสำหรับ docker-compose.yml (คัดลอกเป็น .env ที่ root)
# port ฝั่งเครื่อง dev — เปลี่ยนได้ถ้าชนกับระบบอื่น
POSTGRES_PORT=5442
GARAGE_S3_PORT=3910
GARAGE_ADMIN_PORT=3913

# secret ของ Garage (dev) — สร้างใหม่ด้วย: openssl rand -hex 32 / openssl rand -base64 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
